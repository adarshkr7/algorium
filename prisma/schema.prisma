// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──

enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ContestStatus {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ContestMode {
  BLITZ
  CLASSIC
  LOCKOUT
}

enum PointingSystem {
  ICPC
  POINTS
}

enum HostingType {
  PLAYER_HOST
  SUPERVISED
}

enum ParticipantRole {
  HOST
  GUEST
  SUPERVISOR
  PLAYER_1
  PLAYER_2
}

enum MatchResult {
  WIN
  LOSS
  DRAW
}

/// How allowedTags are applied when selecting problems.
/// ANY = problem matches if it carries at least one allowed tag.
/// ALL = problem must carry every allowed tag.
enum TagMatchMode {
  ANY
  ALL
}

/// What happens when a contestant lets a host-mandated camera or microphone
/// stay off past the grace period.
/// WARN    = everyone is told, the incident is logged, the contest carries on.
/// FORFEIT = the offender is resigned automatically.
enum MediaViolationAction {
  WARN
  FORFEIT
}

enum SeriesStatus {
  IN_PROGRESS
  FINISHED
}

// ── Models ──

model User {
  id                String    @id @default(uuid())
  handle            String    @unique
  avatar            String
  rating            Int       @default(0)
  maxRating         Int       @default(0)
  rank              String    @default("unrated")
  maxRank           String    @default("unrated")
  wins              Int       @default(0)
  losses            Int       @default(0)
  draws             Int       @default(0)
  createdAt         DateTime  @default(now())
  email             String?   @unique
  passwordHash      String?
  verificationToken String?
  tokenExpiresAt    DateTime?

  /// Algorium duel rating — independent of the Codeforces rating.
  elo           Int      @default(1200)
  peakElo       Int      @default(1200)
  /// Consecutive wins. Resets to 0 on a loss, unchanged on a draw.
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  /// Last time the user hit an authenticated endpoint. Drives cache warming.
  lastSeenAt    DateTime @default(now())

  hostedRooms    Room[]         @relation("HostedRooms")
  guestRooms     Room[]         @relation("GuestRooms")
  player1Rooms   Room[]         @relation("Player1Rooms")
  player2Rooms   Room[]         @relation("Player2Rooms")
  participants   Participant[]
  submissions    Submission[]
  matchHistories MatchHistory[]
  series1        MatchSeries[]  @relation("SeriesPlayer1")
  series2        MatchSeries[]  @relation("SeriesPlayer2")

  @@index([elo(sort: Desc)])
  @@index([wins(sort: Desc)])
  @@index([lastSeenAt])
}

model Room {
  id          String      @id @default(uuid())
  code        String      @unique
  hostId      String
  guestId     String?
  hostingType HostingType @default(PLAYER_HOST)
  player1Id   String?
  player2Id   String?
  status      RoomStatus  @default(WAITING)
  createdAt   DateTime    @default(now())

  /// Listed in the public lobby so anyone can join without a code.
  isPublic      Boolean @default(false)
  /// Code of the room this one was created from via "Rematch".
  rematchOfCode String?

  /// Best-of series this room belongs to, if any.
  seriesId   String?
  gameNumber Int     @default(1)

  host    User         @relation("HostedRooms", fields: [hostId], references: [id])
  guest   User?        @relation("GuestRooms", fields: [guestId], references: [id])
  player1 User?        @relation("Player1Rooms", fields: [player1Id], references: [id])
  player2 User?        @relation("Player2Rooms", fields: [player2Id], references: [id])
  series  MatchSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  contest Contest?

  @@index([status, createdAt(sort: Desc)])
  @@index([isPublic, status, createdAt(sort: Desc)])
  @@index([hostId])
  @@index([guestId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([seriesId])
}

model Contest {
  id              String         @id @default(uuid())
  roomId          String         @unique
  name            String
  mode            ContestMode
  pointingSystem  PointingSystem @default(ICPC)
  problemCount    Int            @default(3)
  durationMinutes Int            @default(30)
  minRating       Int            @default(800)
  maxRating       Int            @default(1600)
  allowedTags     String[]
  excludedTags    String[]
  seed            String
  startTime       DateTime?
  endTime         DateTime?
  status          ContestStatus  @default(NOT_STARTED)

  /// ANY (default) or ALL — how allowedTags are combined.
  tagMatchMode TagMatchMode @default(ANY)
  /// Solo practice run: no opponent, no rating change, no match history.
  isSolo       Boolean      @default(false)

  /// The host requires every contestant's camera to stay on for the whole
  /// contest. Supervisors are exempt — they watch rather than compete.
  requireVideo         Boolean              @default(false)
  /// Same, for the microphone.
  requireAudio         Boolean              @default(false)
  /// How long a required device may be off before the violation escalates.
  mediaGraceSeconds    Int                  @default(30)
  mediaViolationAction MediaViolationAction @default(WARN)

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  problems     Problem[]
  participants Participant[]
  submissions  Submission[]
  mediaEvents  MediaEvent[]

  @@index([status])
}

model Problem {
  id             String   @id @default(uuid())
  contestId      String
  problemKey     String // e.g., "1800-A"
  name           String
  rating         Int
  tags           String[]
  indexInContest Int
  lockedWinnerId String? // For Blitz/Lockout: user id who locked it

  contest     Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([contestId, indexInContest])
  @@index([contestId])
}

model Participant {
  id            String          @id @default(uuid())
  contestId     String
  userId        String
  role          ParticipantRole
  score         Int             @default(0)
  penalty       Int             @default(0)
  acceptedCount Int             @default(0)
  isWinner      Boolean         @default(false)
  hasResigned   Boolean         @default(false)

  /// Last state this participant reported for their own devices. Only
  /// meaningful while the contest requires them.
  videoOn             Boolean   @default(false)
  audioOn             Boolean   @default(false)
  /// First time they were seen publishing. Null = never connected.
  mediaJoinedAt       DateTime?
  /// When the current violation started. Null means currently compliant, so
  /// the worker sweep can find offenders with a single indexed lookup.
  violationSince      DateTime?
  mediaViolationCount Int       @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  /// One participant row per user per contest — prevents duplicate joins.
  @@unique([contestId, userId])
  @@index([userId])
  /// The enforcement sweep looks for open violations across every live
  /// contest at once, so it needs to find them without a table scan.
  @@index([violationSince])
}

model Submission {
  id               String   @id @default(uuid())
  contestId        String
  problemId        String
  userId           String
  cfSubmissionId   BigInt
  verdict          String // OK, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, etc.
  passedTestCount  Int      @default(0)
  timeSubmitted    DateTime
  solveTimeSeconds Int? // Seconds from contest start if OK

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  /// The evaluate API route and the background worker can process the same
  /// Codeforces submission concurrently. This makes the insert idempotent.
  @@unique([contestId, cfSubmissionId])
  @@index([contestId, timeSubmitted])
  @@index([userId])
}

model MatchHistory {
  id             String      @id @default(uuid())
  userId         String
  roomCode       String
  opponentHandle String
  mode           ContestMode
  result         MatchResult
  userScore      Int
  opponentScore  Int
  duration       Int // in seconds
  playedAt       DateTime    @default(now())

  /// Elo delta applied for this match, and the resulting rating.
  eloChange Int @default(0)
  eloAfter  Int @default(1200)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, playedAt(sort: Desc)])
  @@index([roomCode])
}

/// A best-of-N run between the same two players. Each game is one Room.
model MatchSeries {
  id          String       @id @default(uuid())
  bestOf      Int          @default(3)
  player1Id   String
  /// Null until the opponent joins the first game of the series.
  player2Id   String?
  player1Wins Int          @default(0)
  player2Wins Int          @default(0)
  draws       Int          @default(0)
  status      SeriesStatus @default(IN_PROGRESS)
  winnerId    String?
  createdAt   DateTime     @default(now())

  player1 User   @relation("SeriesPlayer1", fields: [player1Id], references: [id])
  player2 User?  @relation("SeriesPlayer2", fields: [player2Id], references: [id])
  rooms   Room[]

  @@index([player1Id])
  @@index([player2Id])
}

/// Audit trail of camera/microphone activity in a media-required contest.
/// Drives the supervisor's live view and the post-match compliance summary.
model MediaEvent {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  /// VIDEO_ON | VIDEO_OFF | AUDIO_ON | AUDIO_OFF | JOINED | LEFT | WARNED | FORFEITED
  kind      String
  /// "client" (self-reported) or "server" (worker sweep / media webhook).
  /// Worth keeping — a self-reported event is weaker evidence than a
  /// server-observed one, and the results screen says so.
  source    String
  at        DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId, at])
  @@index([contestId, userId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
