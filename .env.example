# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection used by the app.
DATABASE_URL="postgresql://..."
# Direct connection, used by prisma migrate.
DIRECT_URL="postgresql://..."

# ── Supabase realtime ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="..."

# ── Session signing (REQUIRED in production) ─────────────────────────────────
# Must be at least 32 characters. The app throws on boot in production if this
# is missing or too short. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

# ── Email (password reset OTPs) ──────────────────────────────────────────────
# A Gmail address plus an app password. If unset, reset codes are silently
# skipped and the endpoint still returns its generic response.
EMAIL_USER=""
EMAIL_PASS=""

# ── LiveKit (optional — proctored rooms) ─────────────────────────────────────
# Carries the video when a host requires a camera or microphone. Without these
# the feature still works, but each player only sees their own preview: the
# requirement is enforced from the database either way, just with self-reported
# device state rather than LiveKit's view of what is actually being published.
# Sign up at https://cloud.livekit.io and take the values from the project.
LIVEKIT_URL="wss://<project>.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Same URL again, exposed to the browser so it knows where to connect.
NEXT_PUBLIC_LIVEKIT_URL="wss://<project>.livekit.cloud"
#
# In the LiveKit project settings, point a webhook at:
#   https://<your-domain>/api/media/webhook
# It is what tells the server a camera was switched off, rather than waiting
# for the player to admit it. Signed with the API key/secret above.

# ── Redis (optional in dev, expected in production) ──────────────────────────
# Two jobs:
#  1. Caches each player's solved-problem set so contest generation doesn't
#     wait on the Codeforces API.
#  2. Holds the API rate-limit counters. Without it each instance keeps its own
#     counters in memory, so the effective limit on the auth endpoints becomes
#     "limit x number of instances" — and on serverless, where every cold start
#     begins with an empty map, close to no limit at all.
# A single-instance deployment survives without it; anything scaled out should
# set it.
REDIS_URL="redis://localhost:6379"
